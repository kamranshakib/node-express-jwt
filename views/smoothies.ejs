<%- include('partials/header'); -%>

<div class="max-w-7xl mx-auto px-4 py-10">
  <h2 class="text-4xl font-extrabold text-center mb-10 text-gray-800 dark:text-gray-100 tracking-tight">
    🍹 Ice Creams
  </h2>

  <ul class="grid gap-6 grid-cols-2 sm:grid-cols-2 lg:grid-cols-3">
    <% iceCream.forEach(ice => { %>
    <li class="recipe bg-white dark:bg-gray-900 rounded-2xl shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col">

      <!-- Image -->
      <div class="w-full aspect-[4/3] overflow-hidden rounded-t-2xl">
        <img src="<%= ice.imageUrl %>" alt="<%= ice.name %>"
             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>

      <!-- Content -->
      <div class="p-3 flex-1 flex flex-col justify-between">
        <div>
          <h4 class="text-sm sm:text-lg md:text-xl font-bold text-gray-800 dark:text-gray-100 mb-1 truncate"><%= ice.name %></h4>
          <p class="text-xs sm:text-px sm:text-pink-500 font-medium mb-1 truncate"><%= ice.Flavor %></p>
          <p class="text-sm sm:text-base text-green-600 font-semibold">$<%= ice.Price %></p>
        </div>

        <!-- Buttons -->
        <div class="mt-3 flex flex-col sm:flex-row gap-2">
          <a href="/icecream/<%= ice._id %>"
             class="flex-1 text-center py-1 sm:py-2 text-xs sm:text-sm bg-gradient-to-r from-yellow-400 to-orange-500 text-white font-semibold rounded-xl shadow hover:scale-105 transition-transform">
            Details
          </a>

          <% if (user && user.email.toLowerCase() === "admin@gmail.com") { %>
          <a href="/adminPage_edit/<%= ice._id %>"
             class="flex-1 text-center py-1 sm:py-2 text-xs sm:text-sm bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold rounded-xl shadow hover:scale-105 transition-transform">
            Edit
          </a>

          <form action="/adminPage_delete/<%= ice._id %>" method="POST" class="flex-1">
            <button type="submit"
                    class="w-full py-1 sm:py-2 text-xs sm:text-sm bg-gradient-to-r from-red-500 to-pink-500 text-white font-semibold rounded-xl shadow hover:scale-105 transition-transform"
                    onclick="return confirm('Are you sure you want to delete <%= ice.name %>?')">
              Delete
            </button>
          </form>
          <% } %>
        </div>
      </div>
    </li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer'); -%>
