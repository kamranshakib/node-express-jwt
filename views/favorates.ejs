<%- include('partials/header'); -%>

<main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-10 px-4">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-8 flex items-center gap-2">
       My Favorites
    </h1>

    <% if (favorates.length === 0) { %>
      <div class="bg-white dark:bg-gray-800 shadow-lg rounded-2xl p-10 text-center">
        <p class="text-lg text-gray-600 dark:text-gray-300">You have no products in your favorites list.</p>
        <a href="/smoothies" class="mt-6 inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-xl transition">
          Back to Shop
        </a>
      </div>
    <% } else { %>
    
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% favorates.forEach(product => { %>
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow hover:shadow-xl transition transform hover:-translate-y-1 p-4 flex flex-col">
            
            <!-- Product Image -->
            <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="rounded-xl object-cover h-48 w-full mb-4">
            
            <!-- Flavor Badge -->
            <% if (product.Flavor) { %>
              <span class="bg-gradient-to-r from-pink-500 to-purple-500 text-white text-xs font-semibold px-3 py-1 rounded-full w-max mb-2">
                <%= product.Flavor %>
              </span>
            <% } %>

            <!-- Product Name -->
            <h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100">
              <%= product.name %>
            </h3>

            <!-- Description -->
            <% if (product.Description) { %>
              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-3">
                <%= product.Description %>
              </p>
            <% } %>

            <!-- Price -->
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Price: <span class="font-bold"><%= product.Price %> $</span>
            </p>

            <!-- Remove Button -->
            <form action="/favorites/add" method="POST" class="mt-auto">
              <input type="hidden" name="productId" value="<%= product._id %>">
              <button 
                type="submit"
                class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-2 rounded-xl shadow transition">
                Remove from Favorites
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer'); -%>
