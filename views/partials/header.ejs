<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kami Smoothie</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <link rel="Icon" href="/11880.png">
  <script>
    tailwind.config = { darkMode: 'class' }
  </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-500">

<!-- Navbar -->
<nav class="bg-white dark:bg-gray-800 shadow-md relative">
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <h1 class="text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-yellow-400 to-orange-500 
               bg-clip-text text-transparent drop-shadow-lg transform transition duration-300 hover:scale-105">
      <a href="/">Kami Smoothie</a>
    </h1>

    <!-- Desktop Menu -->
    <ul class="hidden md:flex items-center space-x-4 font-medium">
      <% if (user) { %>
        <li>Welcome, <span class="font-semibold text-pink-600"><%= user.email %></span></li>

        <% if (user.email === "Admin@gmail.com") { %>
          <li>
            <a href="/admin" class="px-4 py-2 text-sm bg-yellow-500 text-white rounded-lg shadow hover:bg-yellow-600 transition">
              Admin Page
            </a>
          </li>
        <% } %>

        <!-- Favorites -->
        <li>
          <a href="/favorates" class="relative flex items-center justify-center hover:scale-110 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 class="w-7 h-7 transition-all duration-300 hover:scale-125">
              <defs>
                <linearGradient id="heartGradient" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ff7eb3"/>
                  <stop offset="50%" stop-color="#ff758c"/>
                  <stop offset="100%" stop-color="#ff3f6f"/>
                </linearGradient>
              </defs>
              <path fill="url(#heartGradient)"
                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
                       2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 
                       4.5 2.09C13.09 3.81 14.76 3 
                       16.5 3 19.58 3 22 5.42 
                       22 8.5c0 3.78-3.4 6.86-8.55 
                       11.54L12 21.35z"/>
            </svg>
            <span id="favorites-count"
                  class="absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">
              <%= favorates?.length || 0 %>
            </span>
          </a>
        </li>

        <!-- Cart -->
        <li>
          <a href="/cart" class="relative flex items-center justify-center hover:text-pink-500 transition">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m13-9l2 9m-5-9V6a2 2 0 10-4 0v7" />
            </svg>
            <span id="cart-count"
                  class="absolute -top-2 -right-2 bg-pink-500 text-white text-xs px-2 py-0.5 rounded-full">0</span>
          </a>
        </li>

        <li><a href="/logout" class="hover:text-pink-600 transition-colors">Log out</a></li>
      <% } else { %>
        <li><a href="/login" class="px-4 py-2 text-sm border border-pink-500 rounded-lg text-pink-600 hover:bg-pink-50 transition">Log in</a></li>
        <li><a href="/signup" class="px-4 py-2 text-sm bg-pink-500 text-white rounded-lg shadow hover:bg-pink-600 transition">Sign up</a></li>
      <% } %>

      <!-- Dark Mode Button -->
      <li>
        <button id="dark-toggle" class="px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 dark:text-yellow-300">
          🌙
        </button>
      </li>
    </ul>

    <!-- Mobile Menu Button -->
    <button id="menu-btn" class="md:hidden text-gray-700 dark:text-gray-200 focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none"
           viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Overlay -->
<div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-40"></div>

<!-- Mobile Sidebar Menu -->
<div id="mobile-menu"
     class="fixed top-0 right-0 h-full w-2/3 sm:w-1/2 bg-white dark:bg-gray-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 flex flex-col">

  <div class="p-4 border-b dark:border-gray-700 text-center font-semibold">
    <% if (user) { %><%= user.email %><% } else { %>Guest<% } %>
  </div>

  <% if (user) { %>
  <div class="flex justify-center items-center gap-6 my-4">
    <a href="/favorates" class="relative text-gray-700 dark:text-gray-200 hover:scale-110 transition">
      ❤️ <span id="favorites-count-mobile"
               class="absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">
               <%= favorates?.length || 0 %>
      </span>
    </a>
  </div>
  <% } %>
</div>
<!-- 🛒 Shopping Cart Sidebar -->
<div id="cart-panel"
     class="fixed top-0 right-0 h-full w-80 sm:w-96 bg-white dark:bg-gray-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-[60] flex flex-col">

  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 border-b dark:border-gray-700">
    <h2 class="text-lg font-semibold">Shopping Cart</h2>
    <button id="close-cart" class="text-gray-600 dark:text-gray-300 hover:text-pink-500 text-2xl">&times;</button>
  </div>

  <!-- Cart Items -->
  <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3">
    <p class="text-gray-500 text-center">Your cart is empty 🛍️</p>
  </div>

  <!-- Cart Footer -->
  <div class="border-t dark:border-gray-700 p-4 bg-gray-50 dark:bg-gray-900">
    <div class="flex justify-between mb-3">
      <span class="font-medium">Total:</span>
      <span id="cart-total" class="font-semibold">$0.00</span>
    </div>
    <button id="clear-cart"
            class="w-full bg-pink-500 hover:bg-pink-600 text-white font-medium py-2 rounded-lg transition">
      Clear Cart
    </button>
  </div>
</div>

<!-- Overlay when cart is open -->
<div id="cart-overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[50]"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const cartPanel = document.getElementById("cart-panel");
  const cartOverlay = document.getElementById("cart-overlay");
  const cartBtn = document.querySelector('a[href="/cart"]'); // آیکن کارت در نوار بالا
  const closeCart = document.getElementById("close-cart");

  // باز کردن کارت
  cartBtn.addEventListener("click", (e) => {
    e.preventDefault();
    cartPanel.classList.remove("translate-x-full");
    cartOverlay.classList.remove("hidden");
  });

  // بستن کارت
  closeCart.addEventListener("click", () => {
    cartPanel.classList.add("translate-x-full");
    cartOverlay.classList.add("hidden");
  });
  cartOverlay.addEventListener("click", () => {
    cartPanel.classList.add("translate-x-full");
    cartOverlay.classList.add("hidden");
  });
});
</script>


<script>
  document.addEventListener('DOMContentLoaded', () => {

    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('overlay');
    const darkToggle = document.getElementById('dark-toggle');
    const html = document.documentElement;

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.remove('translate-x-full');
      overlay.classList.remove('hidden');
    });
    overlay.addEventListener('click', () => {
      mobileMenu.classList.add('translate-x-full');
      overlay.classList.add('hidden');
    });

   
    darkToggle.addEventListener('click', () => {
      html.classList.toggle('dark');
      localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light");
    });
    if (localStorage.getItem("theme") === "dark") html.classList.add("dark");

    // ========================
    // =========================
    function updateFavCountDisplay() {
      const favCount = localStorage.getItem('favoritesCount') || "<%= favorates?.length || 0 %>";
      const favEl = document.getElementById("favorites-count");
      const favElMobile = document.getElementById("favorites-count-mobile");
      if (favEl) favEl.innerText = favCount;
      if (favElMobile) favElMobile.innerText = favCount;
    }

    updateFavCountDisplay();

    window.toggleFavorite = async function(productId) {
      try {
        const res = await fetch('/toggleFavorite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId })
        });

        const data = await res.json();
        if (!data.success) return alert(data.message);

        let current = parseInt(localStorage.getItem('favoritesCount') || "<%= favorates?.length || 0 %>");
        const newCount = data.isFavorite ? current + 1 : Math.max(current - 1, 0);
        localStorage.setItem('favoritesCount', newCount);

        updateFavCountDisplay();
      } catch(e) { console.error(e); }
    };

  }); // DOMContentLoaded
</script>

</body>
</html>
