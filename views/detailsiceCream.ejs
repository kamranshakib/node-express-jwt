<%- include('partials/header'); -%>
<!-- 🛒 Shopping Cart Sidebar -->
<div id="cart-panel"
     class="fixed top-0 right-0 h-full w-80 sm:w-96 bg-white dark:bg-gray-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-[60] flex flex-col">

  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 border-b dark:border-gray-700">
    <h2 class="text-lg font-semibold">Shopping Cart</h2>
    <button id="close-cart" class="text-gray-600 dark:text-gray-300 hover:text-pink-500 text-2xl">&times;</button>
  </div>

  <!-- Cart Items -->
  <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3">
    <p class="text-gray-500 text-center">Your cart is empty 🛍️</p>
  </div>

  <!-- Cart Footer -->
  <div class="border-t dark:border-gray-700 p-4 bg-gray-50 dark:bg-gray-900">
    <div class="flex justify-between mb-3">
      <span class="font-medium">Total:</span>
      <span id="cart-total" class="font-semibold">$0.00</span>
    </div>
    <button id="clear-cart"
            class="w-full bg-pink-500 hover:bg-pink-600 text-white font-medium py-2 rounded-lg transition">
      Clear Cart
    </button>
  </div>
</div>

<!-- Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[50]"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const cartPanel = document.getElementById("cart-panel");
  const cartOverlay = document.getElementById("cart-overlay");
  const cartBtn = document.querySelector('a[href="/cart"]'); // آیکن کارت در هدرت
  const closeCart = document.getElementById("close-cart");
  const clearCartBtn = document.getElementById("clear-cart");
  const cartItemsContainer = document.getElementById("cart-items");
  const cartTotalEl = document.getElementById("cart-total");

  // باز و بسته کردن کارت
  function openCart() {
    cartPanel.classList.remove("translate-x-full");
    cartOverlay.classList.remove("hidden");
  }
  function closeCartFn() {
    cartPanel.classList.add("translate-x-full");
    cartOverlay.classList.add("hidden");
  }

  cartBtn.addEventListener("click", (e) => { e.preventDefault(); openCart(); });
  closeCart.addEventListener("click", closeCartFn);
  cartOverlay.addEventListener("click", closeCartFn);

  // مدیریت کارت در localStorage
  function getCart() {
    return JSON.parse(localStorage.getItem("cartItems") || "[]");
  }
  function saveCart(cart) {
    localStorage.setItem("cartItems", JSON.stringify(cart));
    renderCart();
  }

  function addToCart(product) {
    let cart = getCart();
    const index = cart.findIndex(item => item.id === product.id);
    if (index > -1) {
      cart[index].quantity += 1;
    } else {
      cart.push({...product, quantity: 1});
    }
    saveCart(cart);
    openCart();
  }

  function removeFromCart(productId) {
    let cart = getCart();
    cart = cart.filter(item => item.id !== productId);
    saveCart(cart);
  }

  function clearCart() {
    localStorage.removeItem("cartItems");
    renderCart();
  }

  function renderCart() {
    const cart = getCart();
    cartItemsContainer.innerHTML = "";
    if (cart.length === 0) {
      cartItemsContainer.innerHTML = '<p class="text-gray-500 text-center">Your cart is empty 🛍️</p>';
      cartTotalEl.textContent = "$0.00";
      return;
    }

    let total = 0;
    cart.forEach(item => {
      total += item.price * item.quantity;
      const itemEl = document.createElement("div");
      itemEl.className = "flex items-center justify-between border-b border-gray-200 dark:border-gray-700 pb-2";
      itemEl.innerHTML = `
        <div class="flex items-center gap-3">
          <img src="${item.image}" class="w-16 h-16 object-cover rounded" alt="${item.name}">
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-100">${item.name}</p>
            <p class="text-gray-600 dark:text-gray-300 text-sm">$${item.price} x ${item.quantity}</p>
          </div>
        </div>
        <button class="text-red-500 font-bold hover:text-red-700 remove-item">×</button>
      `;
      itemEl.querySelector(".remove-item").addEventListener("click", () => removeFromCart(item.id));
      cartItemsContainer.appendChild(itemEl);
    });
    cartTotalEl.textContent = `$${total.toFixed(2)}`;
  }

  // دکمه Clear Cart
  clearCartBtn.addEventListener("click", clearCart);

  // دکمه Add to Cart صفحه محصول
  const addToCartBtn = document.querySelector('button[onclick="orderNotReady()"]');
  if (addToCartBtn) {
    addToCartBtn.addEventListener("click", () => {
      const product = {
        id: "<%= ice._id %>",
        name: "<%= ice.name %>",
        price: <%= ice.Price %>,
        image: "<%= ice.imageUrl %>"
      };
      addToCart(product);
      showToast(`${product.name} added to cart!`);
    });
  }

  // Toast
  const toast = document.getElementById("toast");
  function showToast(message, type = "success") {
    toast.textContent = message;
    toast.classList.remove("hidden", "opacity-0", "bg-red-600", "bg-green-600");
    toast.classList.add(type === "success" ? "bg-green-600" : "bg-red-600");
    toast.classList.add("opacity-100");
    setTimeout(() => {
      toast.classList.add("opacity-0");
      setTimeout(() => toast.classList.add("hidden"), 300);
    }, 2000);
  }

  // Render initial cart
  renderCart();
});
</script>


<div class="min-h-screen w-full flex items-center justify-center bg-gray-100 dark:bg-gray-900 px-0 md:px-4 py-0 md:py-10">

  <!-- Product Card -->
  <div class="bg-white dark:bg-gray-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden flex flex-col md:flex-row w-full md:max-w-5xl">

    <!-- Left: Product Image -->
    <div class="w-full md:w-1/2 relative flex-shrink-0">
      <img src="<%= ice.imageUrl %>" 
           alt="<%= ice.name %>"
           class="block w-full h-64 sm:h-80 md:h-[500px] object-cover md:rounded-l-3xl md:rounded-tr-none">

      <!-- Mobile Back Icon -->
      <a href="/smoothies" 
         class="absolute top-3 left-3 md:hidden bg-white dark:bg-gray-700 p-2 rounded-full shadow hover:scale-110 transition z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-800 dark:text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>

      <!-- Favorite Button -->
      <button data-id="<%= ice._id %>" 
        class="favorite-btn absolute top-3 right-3 md:top-4 md:right-4 bg-white dark:bg-gray-700 p-3 rounded-full shadow-lg hover:scale-110 transition z-50 group">
        <!-- Heart SVG -->
        <svg class="heart-svg h-8 w-8 transition-all duration-300 ease-in-out 
             <%= ice.isFavorite ? 'text-pink-500 scale-110 drop-shadow-lg' : 'text-gray-400' %>"
             xmlns="http://www.w3.org/2000/svg"
             fill="<%= ice.isFavorite ? 'currentColor' : 'none' %>"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 
                   2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 
                   4.5 2.09C13.09 3.81 14.76 3 
                   16.5 3 19.58 3 22 5.42 
                   22 8.5c0 3.78-3.4 6.86-8.55 
                   11.54L12 21.35z"/>
        </svg>
        <span class="absolute inset-0 rounded-full bg-pink-200 opacity-0 group-hover:opacity-30 blur-lg transition"></span>
      </button>
    </div>

    <!-- Right: Product Details -->
    <div class="md:w-1/2 w-full p-6 flex flex-col justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4 text-center md:text-left">
          <%= ice.name %>
        </h2>
        <p class="text-green-600 dark:text-green-400 font-semibold text-xl mb-4 text-center md:text-left">
          $<%= ice.Price %> / each
        </p>

        <p class="text-gray-600 dark:text-gray-400 text-base mb-6 leading-relaxed text-center md:text-left">
          <%= ice.Description %>
        </p>

        <!-- Extra Info -->
        <div class="grid grid-cols-3 text-center text-gray-700 dark:text-gray-300 text-sm mb-6">
          <div>
            <p class="font-bold">Flavor</p>
            <p><%= ice.Flavor %></p>
          </div>
          <div>
            <p class="font-bold">Price</p>
            <p>$<%= ice.Price %></p>
          </div>
          <div>
            <p class="font-bold">Delivery</p>
            <p>30 min</p>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex flex-col md:flex-row gap-4">
        <button onclick="orderNotReady()" 
          class="flex-1 px-6 py-3 bg-green-600 text-white font-semibold rounded-full shadow-md hover:bg-green-500 transition text-lg">
          🛒 Add to Cart
        </button>

        <a href="/smoothies" 
           class="hidden md:inline-flex flex-1 items-center justify-center px-6 py-3 bg-gray-200 dark:bg-gray-700 
           text-gray-800 dark:text-gray-200 text-center font-semibold rounded-full shadow 
           hover:bg-gray-300 dark:hover:bg-gray-600 transition text-lg">
          Back to Menu
        </a>
      </div>
    </div>

  </div>
</div>

<!-- Toast -->
<div id="toast" class="hidden fixed top-4 right-4 bg-gray-800 text-white px-4 py-2 rounded-lg shadow-lg transition-opacity duration-300 opacity-0"></div>

<script>

  const favoriteButtons = document.querySelectorAll(".favorite-btn");
  const toast = document.getElementById("toast");

  function showToast(message, type = "success") {
    toast.textContent = message;
    toast.classList.remove("hidden", "opacity-0", "bg-red-600", "bg-green-600");
    toast.classList.add(type === "success" ? "bg-green-600" : "bg-red-600");
    toast.classList.add("opacity-100");

    setTimeout(() => {
      toast.classList.add("opacity-0");
      setTimeout(() => toast.classList.add("hidden"), 300);
    }, 3000);
  }

  
  function updateFavoritesCount(isAdding) {
    const counter = document.getElementById("favorites-count");
    if (counter) {
      let current = parseInt(counter.textContent || "0", 10);
      current += isAdding ? 1 : -1;
      if (current < 0) current = 0;
      counter.textContent = current;
    }
  }

  favoriteButtons.forEach(button => {
    button.addEventListener("click", async (event) => {
      const btn = event.currentTarget;
      const heart = btn.querySelector(".heart-svg");
      const productId = btn.dataset.id;

      try {
        const res = await fetch("/favorites/add", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ productId })
        });

        const data = await res.json();

        if (data.success) {
          if (data.isFavorite) {
            heart.classList.add("text-pink-500", "scale-110", "drop-shadow-lg");
            heart.classList.remove("text-gray-400");
            heart.setAttribute("fill", "currentColor");
            updateFavoritesCount(true);
          } else {
            heart.classList.remove("text-pink-500", "scale-110", "drop-shadow-lg");
            heart.classList.add("text-gray-400");
            heart.setAttribute("fill", "none");
            updateFavoritesCount(false);
          }
          showToast(data.message, "success");
        } else {
          showToast(data.message || "مشکلی پیش آمد!", "error");
        }
      } catch (err) {
        showToast("خطای سرور! دوباره تلاش کنید", "error");
      }
    });
  });
</script>
