<%- include('partials/header'); -%>

<div class="min-h-screen w-full flex items-center justify-center bg-gray-100 dark:bg-gray-900 px-0 md:px-4 py-0 md:py-10">

  <!-- Product Card -->
  <div class="bg-white dark:bg-gray-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden flex flex-col md:flex-row w-full md:max-w-5xl">

    <!-- Left: Product Image -->
    <div class="w-full md:w-1/2 relative flex-shrink-0">
      <img src="<%= ice.imageUrl %>" 
           alt="<%= ice.name %>"
           class="block w-full h-64 sm:h-80 md:h-[500px] object-cover md:rounded-l-3xl md:rounded-tr-none">

      <!-- Mobile Back Icon -->
      <a href="/smoothies" 
         class="absolute top-3 left-3 md:hidden bg-white dark:bg-gray-700 p-2 rounded-full shadow hover:scale-110 transition z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-800 dark:text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>

      <!-- Favorite Button -->
      <button class="absolute top-3 right-3 md:top-4 md:right-4 bg-white dark:bg-gray-700 p-3 rounded-full shadow hover:scale-110 transition z-10">
        ❤️
      </button>
    </div>

    <!-- Right: Product Details -->
    <div class="md:w-1/2 w-full p-6 flex flex-col justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4 text-center md:text-left">
          <%= ice.name %>
        </h2>
        <p class="text-green-600 dark:text-green-400 font-semibold text-xl mb-4 text-center md:text-left">
          $<%= ice.Price %> / each
        </p>

        <p class="text-gray-600 dark:text-gray-400 text-base mb-6 leading-relaxed text-center md:text-left">
          <%= ice.Description %>
        </p>

        <!-- Extra Info -->
        <div class="grid grid-cols-3 text-center text-gray-700 dark:text-gray-300 text-sm mb-6">
          <div>
            <p class="font-bold">Flavor</p>
            <p><%= ice.Flavor %></p>
          </div>
          <div>
            <p class="font-bold">Price</p>
            <p>$<%= ice.Price %></p>
          </div>
          <div>
            <p class="font-bold">Delivery</p>
            <p>30 min</p>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex flex-col md:flex-row gap-4">
        <button onclick="orderNotReady()" 
          class="flex-1 px-6 py-3 bg-green-600 text-white font-semibold rounded-full shadow-md hover:bg-green-500 transition text-lg">
          🛒 Add to Cart
        </button>

        <!-- big Back to Menu: hidden on mobile -->
        <a href="/smoothies" 
           class="hidden md:inline-flex flex-1 items-center justify-center px-6 py-3 bg-gray-200 dark:bg-gray-700 
           text-gray-800 dark:text-gray-200 text-center font-semibold rounded-full shadow 
           hover:bg-gray-300 dark:hover:bg-gray-600 transition text-lg">
          Back to Menu
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function orderNotReady() {
    alert(" سفارش آنلاین در حال توسعه است. به‌زودی فعال می‌شود!");
  }
</script>
