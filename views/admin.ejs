<%- include('partials/header'); -%>

<div class="max-w-3xl mx-auto bg-white dark:bg-gray-900 shadow-lg rounded-2xl p-8 mt-10">  
  <h1 class="text-3xl font-bold text-center mb-6 text-pink-600">🍦 Add New Ice Cream</h1>

  <form action="/adminPage_post" method="POST" enctype="multipart/form-data" class="space-y-6">
    <!-- Ice Cream Name -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ice Cream Name:</label>
      <input type="text" id="name" name="name" placeholder="e.g. Vanilla Delight"
             class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-pink-400 focus:outline-none dark:bg-gray-800 dark:text-gray-100" required>
    </div>

    <!-- Flavor -->
    <div>
      <label for="flavor" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Flavor:</label>
      <input type="text" id="flavor" name="flavor" placeholder="e.g. Chocolate"
             class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-pink-400 focus:outline-none dark:bg-gray-800 dark:text-gray-100" required>
    </div>

    <!-- Description -->
    <div>
      <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description:</label>
      <textarea id="description" name="description" rows="3" placeholder="Write something about this ice cream..."
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-pink-400 focus:outline-none dark:bg-gray-800 dark:text-gray-100" required></textarea>
    </div>

    <!-- Price -->
    <div>
      <label for="price" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Price ($):</label>
      <input type="text" step="0.1" id="price" name="price" placeholder="e.g. 2.5"
             class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-pink-400 focus:outline-none dark:bg-gray-800 dark:text-gray-100" required>
    </div>

    <!-- Image Upload -->
    <div>
      <label for="image" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Image:</label>
      <input type="file" id="image" name="image"
             class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm bg-gray-50 dark:bg-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-pink-400 focus:outline-none">
    </div>
 
    <!-- Button -->
    <div class="text-center">
      <button type="submit"
              class="bg-pink-500 hover:bg-pink-600 text-white font-semibold px-6 py-3 rounded-lg shadow-md transition">
        Add Ice Cream
      </button>
    </div>
  </form>

  <div class="text-center mt-6">
    <a href="/" class="text-gray-600 dark:text-gray-400 hover:text-pink-600 font-medium"> Back to Home</a>
  </div>
</div>

<%- include('partials/footer'); -%>
