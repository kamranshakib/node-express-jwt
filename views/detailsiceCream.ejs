<%- include('partials/header'); -%>

<div class="max-w-5xl mx-auto px-4 py-10">
  <div class="bg-white dark:bg-gray-900 shadow-2xl rounded-3xl overflow-hidden grid grid-cols-1 md:grid-cols-2 transition-colors duration-300">
    
    <!-- Image Section -->
    <div class="flex items-center justify-center bg-gradient-to-br from-pink-50 to-pink-100 dark:from-gray-800 dark:to-gray-700 p-6">
      <img src="<%=ice.imageUrl  %>" 
           alt="<%= ice.name %>"  
           class="w-full max-w-md h-80 object-cover rounded-2xl shadow-lg transition-transform duration-500 hover:scale-105 hover:shadow-2xl">
    </div>

    <!-- Details Section -->
    <div class="p-10 flex flex-col justify-center">
      <h2 class="text-4xl font-extrabold text-gray-800 dark:text-gray-100 mb-4 tracking-tight">
        <%= ice.name %>
      </h2>
      <p class="text-lg text-pink-600 dark:text-pink-400 font-semibold mb-3">
        🍨 Flavor: <%= ice.Flavor %>
      </p>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
        <span class="font-semibold">Description:</span> <%= ice.Description %>
      </p>
      <p class="text-3xl font-bold text-green-600 dark:text-green-400 mb-8">$<%= ice.Price %></p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4">
        <!-- Order Button -->
        <button onclick="orderNotReady()" 
          class="flex-1 px-6 py-3 bg-gradient-to-r from-pink-500 to-red-500 text-white font-semibold rounded-xl shadow-md hover:scale-105 hover:shadow-xl hover:from-pink-400 hover:to-red-400 transition-all duration-300">
          Order Now
        </button>

        <!-- Back Button -->
        <a href="/smoothies" 
           class="flex-1 px-6 py-3 bg-gradient-to-r from-yellow-400 to-orange-500 text-white font-semibold rounded-xl shadow-md hover:scale-105 hover:shadow-xl hover:from-yellow-300 hover:to-orange-400 transition-all duration-300 text-center">
          Back to Menu
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function orderNotReady() {
    alert("🍦 سفارش آنلاین در حال توسعه است. به‌زودی فعال می‌شود!");
  }
</script>

<%- include('partials/footer'); -%>
